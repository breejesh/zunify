{
  "name": "zunify",
  "productName": "Zunify",
  "version": "1.0.0",
  "description": "Offline-first desktop music player inspired by the Zune Metro UI",
  "author": {
    "name": "Breejesh Rathod",
    "email": "breejesh2212@gmail.com"
  },
  "homepage": "https://zunify-84327.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/breejesh/zunify.git"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"ng serve\" \"wait-on tcp:4200 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cdk": "^19.2.19",
    "@angular/cli": "^19.2.27",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "@angular/ssr": "^19.2.27",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.4",
    "dexie": "^4.4.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "express": "^4.18.2",
    "jasmine-core": "~5.6.0",
    "jsmediatags": "^3.9.7",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "music-metadata-browser": "^2.5.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "wait-on": "^9.1.0",
    "zone.js": "~0.15.0"
  },
  "build": {
    "appId": "com.breejeshrathod.zunify",
    "productName": "Zunify",
    "copyright": "Copyright © 2026 Breejesh Rathod",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/zunify/browser/**/*",
      "!dist/zunify/browser/assets/audio/**",
      "!dist/zunify/browser/assets/covers/**",
      "electron/**/*",
      "public/favicon.ico",
      "public/icon.ico",
      "public/icon.png"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zunify",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "executableName": "zunify",
      "synopsis": "Zune-inspired offline music player",
      "icon": "build/icon.png",
      "artifactName": "${productName}-linux-${arch}.${ext}"
    }
  }
}
